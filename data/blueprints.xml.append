<weaponBlueprint name="MATTER_ERASER">
	<type>BEAM</type>
	<title>Matter Eraser Beam</title>
	<short>Matter Eraser</short>
	<desc>This horrifying beam weapon created by madmen erases solid matter on contact.</desc>
	<tooltip>Slow but powerful beam weapon, does 3 damage per room hit and double damage to crew.</tooltip>
	<damage>3</damage>
	<sp>0</sp>
	<fireChance>1</fireChance>
	<breachChance>6</breachChance>
	<persDamage>3</persDamage>
	<speed>2</speed>
	<cooldown>30</cooldown>
	<power>4</power>
	<cost>150</cost>
	<bp>7</bp>
	<rarity>0</rarity>
	<length>75</length>
	<image>ba_beam_hit_heavy</image>
	<launchSounds>
		<sound>matter_eraser</sound>
	</launchSounds>
	<weaponArt>matter_eraser</weaponArt> 
</weaponBlueprint>
<weaponBlueprint name="RAILGUN_DIABLO">
	<type>MISSILES</type>
	<tip>tip_missiles</tip>
	<title>Diablo Railgun</title>
	<short>Diablo R.</short>
	<desc>This advanced weapon fires an explosive projectile at incredible speeds, ignoring all shields.</desc>
	<tooltip>Fires 1 shot; pierces all shields, deals 4 damage and causes fires and breaches. Uses 1 missile.</tooltip>
	<damage>4</damage>
	<speed>200</speed>
	<missiles>1</missiles>
	<shots>1</shots>
	<sp>5</sp>
	<fireChance>2</fireChance>
	<breachChance>10</breachChance>
	<stunChance>5</stunChance>
	<cooldown>20</cooldown>
	<power>3</power>
	<cost>125</cost>
	<bp>6</bp>
	<rarity>5</rarity>
	<image>railgun_diablo_shot</image>
	<explosion>ba_explosion_big1_hit</explosion>
	<launchSounds>
		<sound>railgun_diablo</sound>
	</launchSounds>
	<hitShipSounds>
		<sound>smallExplosion</sound>
	</hitShipSounds>
	<hitShieldSounds>
		<sound>hitShield1</sound>
		<sound>hitShield2</sound>
		<sound>hitShield3</sound>
	</hitShieldSounds>
	<missSounds>
		<sound>miss</sound>
	</missSounds>
	<weaponArt>railgun_diablo</weaponArt>
</weaponBlueprint>


<weaponBlueprint name="ARTILLERY_POWERTRIP_EMP">
	<type>BURST</type>
	<title>Powertrip EMP</title>
	<short>EMP</short>
	<desc>Emits a powerful electromagnetic pulse that can disable entire ships and stun crew. 3 minutes base cooldown.</desc>
	<tooltip>Ion pulse weapon that deals incredibly heavy ion damage to the enemy ship and stuns crew. 180 seconds base cooldown.</tooltip>
	<damage>0</damage>
	<ion>1</ion>
	<stun>10</stun>
	<sp>5</sp>
	<radius>70</radius>
	<fireChance>0</fireChance>
	<breachChance>0</breachChance>
	<speed>300</speed>
	<cooldown>180</cooldown>
	<power>1</power>
	<cost>0</cost>
	<bp>5</bp>
	<rarity>0</rarity>
	<explosion>ba_explosion_artillery_circle</explosion>
	<projectiles>
		<projectile count="100" fake="false">ba_effector_impact_1</projectile>
	</projectiles>
	<launchSounds>
		<sound>pulsar</sound>
	</launchSounds>
	<hitShipSounds>
		<sound>silence</sound>
	</hitShipSounds>
	<hitShieldSounds>
		<sound>silence</sound>
	</hitShieldSounds>
	<missSounds>
		<sound>silence</sound>
	</missSounds>
	<weaponArt>artillery_powertrip_emp</weaponArt>
</weaponBlueprint>

